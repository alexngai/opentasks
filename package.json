{
  "name": "opentasks",
  "version": "0.1.4",
  "description": "Universal task graph data structure",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opentasks": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slow": "RUN_SLOW_TESTS=1 vitest run",
    "test:slow:watch": "RUN_SLOW_TESTS=1 vitest",
    "test:e2e": "RUN_FULL_AGENT_TESTS=1 vitest run --config vitest.e2e.config.ts",
    "eval:tac": "npx tsx evals/tac/run.ts",
    "eval:tac:pool": "npx tsx evals/tac/run-pool.ts",
    "eval:tac:pool:bake-ami": "evals/tac/scripts/bake-ec2-ami.sh",
    "eval:tac:pool:bake-docker-snapshot": "evals/tac/scripts/bake-docker-volume-snapshot.sh",
    "test:all": "npm run test && npm run test:slow && npm run test:e2e",
    "prepublishOnly": "npm run build && publint",
    "version:patch": "npm version patch && git push && git push --tags",
    "version:minor": "npm version minor && git push && git push --tags",
    "version:major": "npm version major && git push && git push --tags",
    "publish:npm": "npm run build && npm publish",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "prepare": "husky"
  },
  "keywords": [
    "tasks",
    "todo",
    "task-management"
  ],
  "author": "Alex Ngai",
  "license": "MIT",
  "devDependencies": {
    "@beads/bd": "^0.49.1",
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.10",
    "@types/proper-lockfile": "^4.1.4",
    "acp-factory": "^0.1.12",
    "e2b": "^2.30.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "publint": "^0.3.21",
    "swarmkit-eval": "^0.0.7",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexngai/opentasks.git"
  },
  "optionalDependencies": {
    "@multi-agent-protocol/sdk": "^0.1.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "agent-session-parser": "^0.1.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "graphology-traversal": "^0.3.1",
    "proper-lockfile": "^4.1.2",
    "sessionlog": "^0.0.5",
    "zod": "^4.3.6"
  }
}
