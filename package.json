{
  "name": "opentasks",
  "version": "0.0.1",
  "description": "Universal task graph data structure",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opentasks": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slow": "RUN_SLOW_TESTS=1 vitest run",
    "test:slow:watch": "RUN_SLOW_TESTS=1 vitest",
    "test:e2e": "RUN_FULL_AGENT_TESTS=1 vitest run",
    "test:all": "RUN_FULL_AGENT_TESTS=1 vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tasks",
    "todo",
    "task-management"
  ],
  "author": "Alex Ngai",
  "license": "MIT",
  "devDependencies": {
    "@beads/bd": "^0.49.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.10",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexngai/opentasks.git"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "graphology-traversal": "^0.3.1",
    "proper-lockfile": "^4.1.2"
  }
}
